    ]
  },
  "name": "rekrutteringsbistand",
  "private": true,
  "scripts": {
    "1. Start dev": "run-p dev",
    "2. Start test-dev": "run-p test-dev",
    "3. Kjør playwright tester": "pnpm test",
    "4. Kjør test generator": "pnpm exec playwright codegen --viewport-size=1920,1080",
    "5. Kjør precommit": "run-p formater-kode  type-check lint",
    "kill:port": "(lsof -ti :1337 | xargs kill -9 || true) && (lsof -ti :1337 | xargs kill -9 || true)",
    "a11y": "PUPPETEER_EXECUTABLE_PATH=$(node -e \"console.log(require('@playwright/test').chromium.executablePath())\") pa11y-ci",
    "build": "next build",
    "dev": "next dev -p 1337 | pino-pretty",
    "formater-kode": "prettier --write .",
    "lint": "eslint",
    "open:dev": "open http://localhost:1337",
    "test": "playwright test",
    "test-build": "NEXT_PUBLIC_PLAYWRIGHT_TEST_MODE=true next build",
    "test-dev": "NEXT_PUBLIC_PLAYWRIGHT_TEST_MODE=true next dev -p 1337",
    "type-check": "tsc --noEmit",
    "ubrukt kode": "knip --config ./knip.json",
    "ubrukte typer": "ts-unused-exports tsconfig.unused.json"
  },
  "version": "0.1.0"
}
